@model IEnumerable<OmniTradeMvc.Models.VendorManagementViewModel>

@{
    ViewData["Title"] = "Vendor Approval";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Vendor Approval</h1>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No vendors found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Store Name</th>
                        <th>Contact Email</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var vendor in Model)
                    {
                        <tr>
                            <td>@vendor.Id</td>

                            <td>@vendor.StoreName</td>

                            <td>@vendor.ContactEmail</td>

                            <td>
                                @if (vendor.IsApproved == true)
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (vendor.IsApproved == false)
                                {
                                    <span class="badge bg-danger">
                                        Suspended
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                            </td>

                            <td>
                                <form asp-controller="Admin"
                                      asp-action="ApproveVendor"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@vendor.Id" />

                                    @if (vendor.IsApproved == true)
                                    {
                                        <input type="hidden"
                                               name="isApproved"
                                               value="false" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Suspend
                                        </button>
                                    }
                                    else
                                    {
                                        <input type="hidden"
                                               name="isApproved"
                                               value="true" />

                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            Approve
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>