@model IEnumerable<OmniTradeMvc.Models.ProductViewModel>

@{
    ViewData["Title"] = "My Products";
    var products = Model?.ToList() ?? new List<OmniTradeMvc.Models.ProductViewModel>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Products</h1>

        <div>
            <a asp-controller="Vendors"
               asp-action="CreateProduct"
               class="btn btn-primary me-2">
                Add Product
            </a>

            <a asp-controller="Vendors"
               asp-action="Dashboard"
               class="btn btn-secondary">
                Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!products.Any())
    {
        <div class="alert alert-info">
            You haven't listed any products yet. Click
            <strong>Add Product</strong> to create your first listing.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in products)
                    {
                        <tr>
                            <td>@product.Name</td>

                            <td>@product.Category</td>

                            <td>₹@product.Price.ToString("N2")</td>

                            <td>
                                @if (product.StockQuantity > 0)
                                {
                                    <span class="badge bg-success">
                                        @product.StockQuantity
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Out of stock
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-controller="Vendors"
                                   asp-action="EditProduct"
                                   asp-route-id="@product.Id"
                                   class="btn btn-sm btn-primary me-1">
                                    Edit
                                </a>

                                <form asp-controller="Vendors"
                                      asp-action="DeleteProduct"
                                      asp-route-id="@product.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this product?');">

                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
