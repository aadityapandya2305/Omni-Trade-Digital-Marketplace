@model IEnumerable<OmniTradeMvc.Models.ProductViewModel>

@{
    ViewData["Title"] = "Products Catalog";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="fw-bold text-dark">Products Catalog</h1>
            <p class="text-secondary mb-0">Discover and shop amazing items available across OmniTrade.</p>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var product in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div class="card-body d-flex flex-column p-4">
                            <!-- Category Badge -->
                            <div class="mb-2">
                                <span class="badge bg-secondary text-uppercase small">@product.Category</span>
                            </div>

                            <!-- Product Name & Description -->
                            <h5 class="card-title fw-bold text-dark mb-2">@product.Name</h5>
                            <p class="card-text text-muted small flex-grow-1">@product.Description</p>

                            <!-- Pricing & Stock Details -->
                            <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                                <span class="fs-5 fw-bold text-primary">₹@product.Price.ToString("N2")</span>
                                <span class="badge @(product.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                                    @(product.StockQuantity > 0 ? $"{product.StockQuantity} in stock" : "Out of stock")
                                </span>
                            </div>

                            <!-- Action Button -->
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-primary w-100 fw-semibold">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">No products available at the moment.</p>
            </div>
        }
    </div>

    <!-- Product count -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">
            @products.Count product@(products.Count == 1 ? "" : "s") found
        </h5>
    </div>

    @if (!products.Any())
    {
        <div class="alert alert-info text-center py-4">
            <h5>No products found</h5>
            <p class="mb-0">
                Try searching for a different product.
            </p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var product in products)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body d-flex flex-column">

                            <div class="mb-2">
                                <span class="badge bg-secondary">
                                    @product.Category
                                </span>
                            </div>

                            <h5 class="card-title fw-bold">
                                @product.Name
                            </h5>

                            <p class="card-text text-muted flex-grow-1">
                                @product.Description
                            </p>

                            <div class="mb-2">
                                <span class="fs-4 fw-bold text-primary">
                                    ₹@product.Price.ToString("N2")
                                </span>
                            </div>

                            @if (product.StockQuantity > 0)
                            {
                                <p class="text-success mb-3">
                                    <strong>In Stock:</strong>
                                    @product.StockQuantity
                                </p>
                            }
                            else
                            {
                                <p class="text-danger mb-3">
                                    <strong>Out of Stock</strong>
                                </p>
                            }

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-primary w-100">
                                View Details
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>