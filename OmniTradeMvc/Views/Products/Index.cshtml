@model IEnumerable<OmniTradeMvc.Models.ProductViewModel>

@{
    ViewData["Title"] = "Products Catalog";
    var products = Model?.ToList() ?? new List<OmniTradeMvc.Models.ProductViewModel>();
}

<div class="container py-4">

    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="fw-bold text-dark">Products Catalog</h1>
            <p class="text-secondary mb-0">
                Discover and shop amazing items available across OmniTrade.
            </p>
        </div>
    </div>

    <!-- Search Section -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <form asp-controller="Products"
                  asp-action="Search"
                  method="get"
                  class="row g-2">

                <div class="col-md-10">
                    <input type="text"
                           name="name"
                           class="form-control form-control-lg"
                           placeholder="Search products by name..."
                           value="@ViewBag.SearchTerm" />
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary btn-lg w-100">
                        Search
                    </button>
                </div>

            </form>

            <!-- Search Error -->
            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchError))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    @ViewBag.SearchError
                </div>
            }

            <!-- Search Result Information -->
            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm))
            {
                <div class="mt-3">

                    <span class="text-secondary">
                        Search results for:
                    </span>

                    <strong>
                        "@ViewBag.SearchTerm"
                    </strong>

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-secondary ms-2">
                        Clear Search
                    </a>

                </div>
            }

        </div>
    </div>

    <!-- Product Count -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="mb-0 text-dark">
            @products.Count product@(products.Count == 1 ? "" : "s") found
        </h5>

    </div>

    <!-- Products Grid -->
    <div class="row g-4">

        @if (products.Any())
        {
            @foreach (var product in products)
            {
                <div class="col-md-4">

                    <div class="card h-100 shadow-sm border-0 product-card">

                        <div class="card-body d-flex flex-column p-4">

                            <!-- Category Badge -->
                            <div class="mb-2">
                                <span class="badge bg-secondary text-uppercase small">
                                    @product.Category
                                </span>
                            </div>

                            <!-- Product Name -->
                            <h5 class="card-title fw-bold text-dark mb-2">
                                @product.Name
                            </h5>

                            <!-- Description -->
                            <p class="card-text text-muted small flex-grow-1">
                                @product.Description
                            </p>

                            <!-- Price & Stock -->
                            <div class="d-flex justify-content-between align-items-center mt-3 mb-3">

                                <span class="fs-5 fw-bold text-primary">
                                    ₹@product.Price.ToString("N2")
                                </span>

                                @if (product.StockQuantity > 0)
                                {
                                    <span class="badge bg-success">
                                        @product.StockQuantity in stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Out of stock
                                    </span>
                                }

                            </div>

                            <!-- View Details -->
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-primary w-100 fw-semibold">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <!-- No Products -->
            <div class="col-12 text-center py-5">

                <div class="card border-0 shadow-sm">

                    <div class="card-body py-5">

                        <h5 class="text-muted mb-2">
                            No products found
                        </h5>

                        <p class="text-muted mb-0">
                            Try searching for a different product.
                        </p>

                    </div>

                </div>

            </div>
        }

    </div>

</div>