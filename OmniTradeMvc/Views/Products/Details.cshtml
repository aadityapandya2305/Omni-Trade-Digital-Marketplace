@model OmniTradeMvc.Models.ProductViewModel

@{
    ViewData["Title"] = Model?.Name ?? "Product Details";
}

<div class="container py-5">

    <!-- Back to Catalog -->
    <div class="mb-4">
        <a asp-controller="Products"
           asp-action="Index"
           class="text-decoration-none text-secondary fw-semibold">
            &larr; Back to Products
        </a>
    </div>

    <!-- Cart Messages -->
    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4"
             role="alert">
            @TempData["CartMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4"
             role="alert">
            @TempData["CartError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (Model != null)
    {
        <div class="row justify-content-center">

            <div class="col-md-8">

                <div class="card shadow-sm border-0 p-4">

                    <div class="card-body">

                        <!-- Category & Stock -->
                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="badge bg-secondary text-uppercase px-3 py-2">
                                @Model.Category
                            </span>

                            @if (Model.StockQuantity > 0)
                            {
                                <span class="badge bg-success px-3 py-2">
                                    @Model.StockQuantity in stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">
                                    Out of stock
                                </span>
                            }

                        </div>

                        <!-- Product Name -->
                        <h1 class="fw-bold text-dark mb-3">
                            @Model.Name
                        </h1>

                        <!-- Price -->
                        <div class="mb-4">
                            <span class="fs-3 fw-bold text-primary">
                                ₹@Model.Price.ToString("N2")
                            </span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">

                            <h5 class="fw-semibold text-secondary">
                                Description
                            </h5>

                            <p class="text-muted lh-base mb-0">
                                @Model.Description
                            </p>

                        </div>

                        <hr class="my-4">

                        <!-- Product Information & Actions -->
                        <div class="d-flex justify-content-between align-items-center">

                            <!-- Vendor -->
                            <span class="text-muted small">
                                Vendor ID: #@Model.VendorId
                            </span>

                            <!-- Actions -->
                            <div class="d-flex gap-2 align-items-center">

                                <a asp-controller="Products"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary">
                                    Back to Catalog
                                </a>

                                @if (Model.StockQuantity > 0)
                                {
                                    <form asp-controller="Cart"
                                          asp-action="Add"
                                          method="post"
                                          class="d-flex gap-2 align-items-center">

                                        @Html.AntiForgeryToken()

                                        <!-- Product ID -->
                                        <input type="hidden"
                                               name="productId"
                                               value="@Model.Id" />

                                        <!-- Quantity -->
                                        <input type="number"
                                               name="quantity"
                                               value="1"
                                               min="1"
                                               max="@Model.StockQuantity"
                                               class="form-control"
                                               style="width: 80px;"
                                               aria-label="Quantity" />

                                        <!-- Add to Cart -->
                                        <button type="submit"
                                                class="btn btn-primary px-4">
                                            Add to Cart
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-secondary"
                                            disabled>
                                        Out of Stock
                                    </button>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- Product Not Found -->
        <div class="text-center py-5">

            <h3 class="text-muted">
                Product not found.
            </h3>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary mt-3">
                Return to Products
            </a>

        </div>
    }

</div>