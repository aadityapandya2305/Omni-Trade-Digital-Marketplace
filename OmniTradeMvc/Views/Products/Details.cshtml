@model OmniTradeMvc.Models.ProductViewModel

@{
    ViewData["Title"] = Model?.Name ?? "Product Details";
}

<div class="container py-5">
    <!-- Back to Catalog Link -->
    <div class="mb-4">
        <a asp-controller="Products" asp-action="Index" class="text-decoration-none text-secondary fw-semibold">
            &larr; Back to Products
        </a>
    </div>

    @if (Model != null)
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm border-0 p-4">
                    <div class="card-body">
                        <!-- Category Badge & Status -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-secondary text-uppercase px-3 py-2">@Model.Category</span>
                            <span class="badge @(Model.StockQuantity > 0 ? "bg-success" : "bg-danger") px-3 py-2">
                                @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} in stock" : "Out of stock")
                            </span>
                        </div>

                        <!-- Product Name -->
                        <h1 class="fw-bold text-dark mb-3">@Model.Name</h1>

                        <!-- Price -->
                        <div class="mb-4">
                            <span class="fs-3 fw-bold text-primary">₹@Model.Price.ToString("N2")</span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <h5 class="fw-semibold text-secondary">Description</h5>
                            <p class="text-muted lh-base">@Model.Description</p>
                        </div>

                        <hr class="my-4">

                        <!-- Meta Info / Actions -->
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Vendor ID: #@Model.VendorId</span>

                            <!-- Action buttons -->
                            <div class="d-flex gap-2">
                                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
                                    Back to Catalog
                                </a>
                                @if (Model.StockQuantity > 0)
                                {
                                    <button type="button" class="btn btn-primary px-4">
                                        Add to Cart
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <h3 class="text-muted">Product not found.</h3>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-3">Return to Products</a>
        </div>
    }
</div>