@model OmniTradeMvc.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-md-6">
        <h4>Order Summary</h4>
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Cart.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>@item.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">Grand Total</th>
                    <th>@Model.Cart.TotalAmount.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="col-md-6">
        <h4>Shipping &amp; Payment</h4>

        <form asp-controller="Checkout" asp-action="PlaceOrder" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ShippingAddress" class="form-label"></label>
                <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <select asp-for="PaymentMethod" class="form-select">
                    <option value="">-- Select Payment Method --</option>
                    <option value="COD">Cash on Delivery</option>
                    <option value="Card">Credit / Debit Card</option>
                    <option value="UPI">UPI</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Place Order</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
