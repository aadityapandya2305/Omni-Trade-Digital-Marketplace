@model OmniTradeMvc.Models.OrderViewModel

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="text-center mb-4">
    <h1 class="text-success">Thank you for your order!</h1>
    <p>Your order has been placed successfully.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    <div class="col-md-6">
        <h4>Order Info</h4>
        <table class="table">
            <tr>
                <th>Order ID</th>
                <td>#@Model.Id</td>
            </tr>
            <tr>
                <th>Order Date</th>
                <td>@Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
            </tr>
            <tr>
                <th>Status</th>
                <td><span class="badge bg-info">@Model.Status</span></td>
            </tr>
            <tr>
                <th>Shipping Address</th>
                <td>@Model.ShippingAddress</td>
            </tr>
            <tr>
                <th>Payment Method</th>
                <td>@Model.PaymentMethod</td>
            </tr>
        </table>
    </div>

    <div class="col-md-6">
        <h4>Items Ordered</h4>
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>@item.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">Grand Total</th>
                    <th>@Model.TotalAmount.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="text-center mt-4">
    <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary">View My Orders</a>
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
</div>
