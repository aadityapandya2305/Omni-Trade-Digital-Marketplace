@model IEnumerable<OmniTradeMvc.Models.VendorOrderItemViewModel>

@{
    ViewData["Title"] = "Incoming Orders";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Incoming Orders</h1>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Home
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No incoming orders found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OrderId</td>

                            <td>
                                @item.Product?.Name
                            </td>

                            <td>
                                @item.Quantity
                            </td>

                            <td>
                                ₹@item.UnitPrice.ToString("N2")
                            </td>

                            <td>
                                ₹@((item.Quantity * item.UnitPrice).ToString("N2"))
                            </td>

                            <td>
                                <a asp-controller="Orders"
                                   asp-action="VendorDetails"
                                   asp-route-id="@item.OrderId"
                                   class="btn btn-sm btn-primary">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>