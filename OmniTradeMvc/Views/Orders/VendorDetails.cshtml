@model OmniTradeMvc.Models.VendorOrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Order Details</h1>

        <a asp-controller="Orders"
           asp-action="Incoming"
           class="btn btn-secondary">
            Back to Incoming Orders
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">Order #@Model.OrderId</h4>
        </div>

        <div class="card-body">

            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Order Date:</strong>
                    @Model.OrderDate?.ToString("dd MMM yyyy, HH:mm")
                </div>

                <div class="col-md-4">
                    <strong>Status:</strong>

                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                    else if (Model.Status == "Processing")
                    {
                        <span class="badge bg-info text-dark">
                            Processing
                        </span>
                    }
                    else if (Model.Status == "Shipped")
                    {
                        <span class="badge bg-primary">
                            Shipped
                        </span>
                    }
                    else if (Model.Status == "Delivered")
                    {
                        <span class="badge bg-success">
                            Delivered
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>
                    }
                </div>

                <div class="col-md-4">
                    <strong>Order Total:</strong>
                    ₹@Model.TotalAmount.ToString("N2")
                </div>
            </div>

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">Update Order Status</h4>
        </div>

        <div class="card-body">
            <form asp-controller="Orders"
                  asp-action="UpdateStatus"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="orderId"
                       value="@Model.OrderId" />

                <div class="row align-items-end">

                    <div class="col-md-6">
                        <label for="status" class="form-label">
                            New Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            <option value="Pending"
                                    selected="@(Model.Status == "Pending")">
                                Pending
                            </option>

                            <option value="Processing"
                                    selected="@(Model.Status == "Processing")">
                                Processing
                            </option>

                            <option value="Shipped"
                                    selected="@(Model.Status == "Shipped")">
                                Shipped
                            </option>

                            <option value="Delivered"
                                    selected="@(Model.Status == "Delivered")">
                                Delivered
                            </option>

                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit"
                                class="btn btn-primary">
                            Update Status
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <h4>Products</h4>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>

                        <td>@item.Quantity</td>

                        <td>
                            ₹@item.UnitPrice.ToString("N2")
                        </td>

                        <td>
                            ₹@((item.Quantity * item.UnitPrice).ToString("N2"))
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <div class="mt-4">
        <a asp-controller="Orders"
           asp-action="Incoming"
           class="btn btn-secondary">
            Back to Incoming Orders
        </a>
    </div>

</div>