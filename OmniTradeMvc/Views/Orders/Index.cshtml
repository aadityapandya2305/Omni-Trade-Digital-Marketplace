@model List<OmniTradeMvc.Models.OrderViewModel>

@{
    ViewData["Title"] = "My Orders";
}

<h1>My Orders</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <p>You haven't placed any orders yet.</p>
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Start Shopping</a>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Status</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge bg-info">@order.Status</span></td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                            View Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
